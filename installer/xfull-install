#!/usr/bin/env bash
# x-full installer: one prebuilt X system image, installed offline.
#
# The ISO carries a complete Hyprland + linux-x + NVIDIA root image. The
# installer only partitions, extracts, personalises and installs the
# bootloader; it never resolves or downloads packages.
#
# Interactive on tty1. Non-interactive with XFULL_AUTO=1 (environment or
# xfull.auto=1 on the kernel command line).
set -Eeuo pipefail
umask 022
SECONDS=0

ROOT_DIR=/root/xfull
TARGET_IMAGE=/root/x-target.tar.zst
ASSETS="$ROOT_DIR/assets"
MNT=/mnt
LOG=/tmp/xfull-install.log

log() { printf '\033[1;34m::\033[0m %s\n' "$*" | tee -a "$LOG" >&2; }
ok() { printf '\033[1;32m OK\033[0m %s\n' "$*" | tee -a "$LOG" >&2; }
warn() { printf '\033[1;33m !\033[0m %s\n' "$*" | tee -a "$LOG" >&2; }
die() { printf '\033[1;31m error:\033[0m %s\n' "$*" | tee -a "$LOG" >&2; exit 1; }

phase() {
    log "== $* (${SECONDS}s)"
}

cleanup() {
    local rc=$?
    if mountpoint -q "$MNT"; then
        umount -R "$MNT" 2>/dev/null || umount -Rl "$MNT" 2>/dev/null || true
    fi
    if [[ -b /dev/mapper/xroot ]]; then cryptsetup close xroot 2>/dev/null || true; fi
    rmdir /run/xfull-install.lock.d 2>/dev/null || true
    if (( rc != 0 )); then
        printf '\nInstallation failed (rc=%s). Log: %s\n' "$rc" "$LOG" >&2
        if [[ ${XFULL_AUTO:-0} == 1 ]]; then
            sync
            poweroff -f
        fi
    fi
}
trap cleanup EXIT

banner() {
    clear 2>/dev/null || true
    if [[ -f $ASSETS/logo.txt ]]; then cat "$ASSETS/logo.txt"; fi
    printf '\nX Full — offline installer\n'
    printf 'Edition: Hyprland + linux-x + NVIDIA. Everything is on this ISO.\n\n'
}

choose() { gum choose --height 12 --header "$1" "${@:2}"; }
input() { gum input --header "$1" --value "$2" --placeholder "$3"; }
askpass() { gum input --password --header "$1"; }

partdev() {
    local name=${1##*/}
    if [[ $name =~ [0-9]$ ]]; then printf '%sp' "$1"; else printf '%s' "$1"; fi
}

live_disk() {
    local src pk
    src="$(findmnt -no SOURCE /run/archiso/bootmnt 2>/dev/null || true)"
    [[ -n $src ]] || return 0
    pk="$(lsblk -no PKNAME "$src" 2>/dev/null | head -1 || true)"
    if [[ -n $pk ]]; then printf '/dev/%s' "$pk"; fi
}

valid_extra() {
    [[ -z ${1:-} ]] && return 0
    [[ $1 =~ ^[A-Za-z0-9_=.,:/@%+-]+([[:space:]][A-Za-z0-9_=.,:/@%+-]+)*$ ]]
}

parse_cmdline() {
    local arg
    for arg in $(< /proc/cmdline); do
        case $arg in
            xfull.auto=1) XFULL_AUTO=1 ;;
            xfull.disk=*) XFULL_DISK=${arg#xfull.disk=} ;;
            xfull.mode=*) XFULL_MODE=${arg#xfull.mode=} ;;
            xfull.esp=*) XFULL_ESP=${arg#xfull.esp=} ;;
            xfull.encrypt=*) XFULL_ENCRYPTION=${arg#xfull.encrypt=} ;;
            xfull.luks_pass=*) XFULL_LUKS_PASS=${arg#xfull.luks_pass=} ;;
            xfull.hostname=*) XFULL_HOST=${arg#xfull.hostname=} ;;
            xfull.user=*) XFULL_USER=${arg#xfull.user=} ;;
            xfull.pass=*) XFULL_PASS=${arg#xfull.pass=} ;;
            xfull.locale=*) XFULL_LOCALE=${arg#xfull.locale=} ;;
            xfull.keymap=*) XFULL_KEYMAP=${arg#xfull.keymap=} ;;
            xfull.timezone=*) XFULL_TIMEZONE=${arg#xfull.timezone=} ;;
            xfull.boot=*) XFULL_BOOT=${arg#xfull.boot=} ;;
            xfull.cmdline=*) XFULL_CMDLINE=${arg#xfull.cmdline=} ;;
            xfull.poweroff=1) XFULL_POWEROFF=1 ;;
        esac
    done
}

ask_options() {
    local -a disks=()
    local d live
    live="$(live_disk)"
    while IFS= read -r d; do
        [[ -b $d ]] || continue
        [[ -n $live && $d == "$live" ]] && continue
        disks+=("$d")
    done < <(lsblk -dno PATH,TYPE | awk '$2=="disk"{print $1}' |
        grep -Ev '/fd[0-9]+$|/(sr|loop|zram|ram)[0-9]*$|/dm-')
    (( ${#disks[@]} )) || die "no installable disks found"
    DISK="$(choose 'Installation disk (will be erased)' "${disks[@]}")" || exit 1

    local mode
    mode="$(choose 'Installation mode' \
        'Wipe the selected disk' \
        'Dualboot: use free space, keep the existing ESP')" || exit 1
    [[ $mode == Dualboot* ]] && MODE=dualboot || MODE=wipe

    local -a esp_sizes=(1 2 4 6 8 10 16)
    ESP_SIZE="$(choose 'EFI System Partition size (GiB)' "${esp_sizes[@]}")" || exit 1
    [[ $ESP_SIZE =~ ^[0-9]+$ ]] || ESP_SIZE=2
    (( ESP_SIZE >= 1 && ESP_SIZE <= 64 )) || ESP_SIZE=2

    if gum confirm 'Encrypt the root filesystem (LUKS2)?'; then
        ENC=yes
        local p1 p2
        while true; do
            p1="$(askpass 'LUKS passphrase')"
            p2="$(askpass 'Repeat the LUKS passphrase')"
            if [[ -n $p1 && $p1 == "$p2" ]]; then break; fi
            warn 'passphrases do not match'
        done
        LUKS_PASS="$p1"
    else
        ENC=no; LUKS_PASS=""
    fi

    HOST="$(input 'Hostname' 'x-full' 'x-full')"
    while [[ ! $HOST =~ ^[a-zA-Z0-9][a-zA-Z0-9-]{0,62}$ ]]; do
        HOST="$(input 'Hostname (letters, digits, -)' 'x-full' 'x-full')"
    done

    USER="$(input 'Username' 'x' 'x')"
    while [[ ! $USER =~ ^[a-z_][a-z0-9_-]{0,31}$ ]]; do
        USER="$(input 'Username (lowercase)' 'x' 'x')"
    done

    while true; do
        PASS="$(askpass 'User password')"
        local p2; p2="$(askpass 'Repeat the user password')"
        if [[ -n $PASS && $PASS == "$p2" ]]; then break; fi
        warn 'passwords do not match'
    done

    local locale_list="$ASSETS/locales.txt"
    [[ -f $locale_list ]] || die "missing $locale_list"
    LOCALE="$(gum filter --height 16 --header 'System locale (type to filter)' < "$locale_list")" || true
    [[ -n $LOCALE ]] || LOCALE=en_US.UTF-8
    [[ -e /usr/share/i18n/locales/${LOCALE%%.*} ]] || LOCALE=en_US.UTF-8

    if command -v localectl >/dev/null 2>&1; then
        KEYMAP="$(localectl list-keymaps 2>/dev/null |
            gum filter --height 16 --header 'Keyboard layout (type to filter)')" || true
    fi
    [[ -n ${KEYMAP:-} ]] || KEYMAP=us

    TIMEZONE="$(timedatectl list-timezones 2>/dev/null |
        gum filter --height 16 --header 'Timezone (type to filter)')" || true
    [[ -n $TIMEZONE && -e /usr/share/zoneinfo/$TIMEZONE ]] || TIMEZONE=UTC

    BOOT="$(choose 'Bootloader' 'GRUB (BIOS + UEFI)' 'systemd-boot (UEFI only)')" || exit 1
    [[ $BOOT == systemd-boot* ]] && BOOT=systemd-boot || BOOT=grub
    if [[ $BOOT == systemd-boot && ! -d /sys/firmware/efi ]]; then
        die 'systemd-boot requires booting the installer in UEFI mode'
    fi

    EXTRA_PARAMS="$(input 'Extra kernel parameters (optional)' '' 'quiet nowatchdog')" || true
    if ! valid_extra "$EXTRA_PARAMS"; then
        warn 'invalid kernel parameters; ignoring them'
        EXTRA_PARAMS=""
    fi

    if [[ $ENC == yes ]]; then
        BOOT_DESC="GRUB + LUKS2"
    else
        BOOT_DESC="$BOOT"
    fi
    printf '\nSummary\n'
    printf '  disk:        %s (%s)\n' "$DISK" "$MODE"
    printf '  ESP:         %s GiB\n' "$ESP_SIZE"
    printf '  encryption:  %s\n' "$ENC"
    printf '  hostname:    %s\n' "$HOST"
    printf '  user:        %s\n' "$USER"
    printf '  locale:      %s  keyboard: %s  timezone: %s\n' "$LOCALE" "$KEYMAP" "$TIMEZONE"
    printf '  bootloader:  %s\n' "$BOOT_DESC"
    printf '  edition:     Hyprland (equisdots) + linux-x + NVIDIA\n'
    printf '  extra params: %s\n\n' "${EXTRA_PARAMS:-none}"
}

auto_options() {
    DISK="${XFULL_DISK:-}"
    MODE="${XFULL_MODE:-wipe}"
    ESP_SIZE="${XFULL_ESP:-2}"
    ENC="${XFULL_ENCRYPTION:-no}"
    LUKS_PASS="${XFULL_LUKS_PASS:-}"
    HOST="${XFULL_HOST:-x-full}"
    USER="${XFULL_USER:-x}"
    PASS="${XFULL_PASS:-}"
    LOCALE="${XFULL_LOCALE:-en_US.UTF-8}"
    KEYMAP="${XFULL_KEYMAP:-us}"
    TIMEZONE="${XFULL_TIMEZONE:-UTC}"
    BOOT="${XFULL_BOOT:-grub}"
    EXTRA_PARAMS="${XFULL_CMDLINE:-${XFULL_KERNEL_PARAMS:-}}"
    POWEROFF="${XFULL_POWEROFF:-0}"
    [[ -n $DISK ]] || die 'XFULL_DISK is required in auto mode'
    [[ -n $PASS ]] || die 'XFULL_PASS is required in auto mode'
    [[ $ENC == yes || $ENC == no ]] || die 'XFULL_ENCRYPTION must be yes or no'
    [[ $ENC != yes || -n $LUKS_PASS ]] || die 'XFULL_LUKS_PASS is required with LUKS'
    [[ $MODE == wipe || $MODE == dualboot ]] || die 'XFULL_MODE must be wipe or dualboot'
    [[ $ESP_SIZE =~ ^[0-9]+$ ]] || die 'XFULL_ESP must be a number of GiB'
    (( ESP_SIZE >= 1 && ESP_SIZE <= 64 )) || die 'XFULL_ESP must be between 1 and 64 GiB'
    [[ $USER =~ ^[a-z_][a-z0-9_-]{0,31}$ ]] || die 'XFULL_USER is invalid'
    [[ $HOST =~ ^[a-zA-Z0-9][a-zA-Z0-9-]{0,62}$ ]] || die 'XFULL_HOST is invalid'
    [[ -e /usr/share/i18n/locales/${LOCALE%%.*} ]] || LOCALE=en_US.UTF-8
    [[ -e /usr/share/zoneinfo/$TIMEZONE ]] || TIMEZONE=UTC
    [[ $BOOT == grub || $BOOT == systemd-boot ]] || die 'XFULL_BOOT must be grub or systemd-boot'
    valid_extra "$EXTRA_PARAMS" || die 'XFULL_CMDLINE contains unsupported characters'
}

partition_disk() {
    local live; live="$(live_disk)"
    umount -R "$MNT" 2>/dev/null || true
    if [[ -b /dev/mapper/xroot ]]; then cryptsetup close xroot 2>/dev/null || true; fi
    if [[ -n $live && $DISK == "$live" ]]; then
        die 'the selected disk is the live medium'
    fi
    [[ -b $DISK ]] || die "not a block device: $DISK"

    local bytes
    bytes="$(blockdev --getsize64 "$DISK")"
    (( bytes >= 6 * 1024 * 1024 * 1024 )) || die 'the selected disk is smaller than 6 GiB'

    local ptype; ptype="$(blkid -p -s PTTYPE -o value "$DISK" 2>/dev/null || true)"

    if [[ $MODE == dualboot ]]; then
        [[ -d /sys/firmware/efi ]] || die 'dualboot requires booting the installer in UEFI mode'
        [[ $ptype == gpt ]] || die 'dualboot requires a GPT disk'
        ESP=""
        while read -r dev parttype; do
            [[ -z $dev || $dev == "$DISK" ]] && continue
            if [[ ${parttype,,} == c12a7328-f81f-11d2-ba4b-00a0c93ec93b ]]; then ESP=$dev; break; fi
        done < <(lsblk -ln -o PATH,PARTTYPE "$DISK" 2>/dev/null)
        [[ -b $ESP ]] || die 'no EFI System Partition found for dualboot'
        local start end ssz free_gib
        start="$(sgdisk -F "$DISK")"; end="$(sgdisk -E "$DISK")"
        [[ $start =~ ^[0-9]+$ && $end =~ ^[0-9]+$ ]] || die 'no free space on the disk'
        ssz="$(blockdev --getss "$DISK")"
        free_gib=$(( (end - start + 1) * ssz / 1024 / 1024 / 1024 ))
        (( free_gib >= 6 )) || die "only ${free_gib} GiB free; need at least 6 GiB"
        sgdisk -n "0:${start}:${end}" -t 0:8300 "$DISK"
        partprobe "$DISK" || true
        udevadm settle 2>/dev/null || sleep 2
        ROOTP="$(lsblk -ln -o PATH,PARTN "$DISK" | sort -k2 -n | tail -1 | awk '{print $1}')"
    else
        sgdisk --zap-all "$DISK"
        sgdisk -n 1:0:+1M -t 1:ef02 \
               -n 2:0:+"${ESP_SIZE}G" -t 2:ef00 \
               -n 3:0:0 -t 3:8300 "$DISK"
        partprobe "$DISK" || true
        udevadm settle 2>/dev/null || sleep 2
        ESP="$(partdev "$DISK")2"; ROOTP="$(partdev "$DISK")3"
        mkfs.vfat -F32 "$ESP" >/dev/null
    fi

    if [[ $ENC == yes ]]; then
        phase "LUKS2 on $ROOTP"
        printf '%s' "$LUKS_PASS" | cryptsetup luksFormat --type luks2 --batch-mode --key-file - "$ROOTP"
        printf '%s' "$LUKS_PASS" | cryptsetup open --key-file - "$ROOTP" xroot
        ROOT_DEV=/dev/mapper/xroot
        LUKS_UUID="$(blkid -s UUID -o value "$ROOTP")"
    else
        ROOT_DEV="$ROOTP"; LUKS_UUID=""
    fi
    mkfs.btrfs -f "$ROOT_DEV" >/dev/null

    mkdir -p "$MNT"
    mount "$ROOT_DEV" "$MNT"
    btrfs subvolume create "$MNT/@" >/dev/null
    btrfs subvolume create "$MNT/@home" >/dev/null
    btrfs subvolume create "$MNT/@snapshots" >/dev/null
    btrfs subvolume create "$MNT/@xstate" >/dev/null
    umount "$MNT"
    mount -o "subvol=@,noatime" "$ROOT_DEV" "$MNT"
    mkdir -p "$MNT/boot" "$MNT/home" "$MNT/.snapshots" "$MNT/var/lib/x"
    mount -o "subvol=@home,noatime" "$ROOT_DEV" "$MNT/home"
    mount -o "subvol=@snapshots,noatime" "$ROOT_DEV" "$MNT/.snapshots"
    mount -o "subvol=@xstate,noatime" "$ROOT_DEV" "$MNT/var/lib/x"
    chmod 700 "$MNT/.snapshots" "$MNT/var/lib/x"
    mount "$ESP" "$MNT/boot"
    ok "disk prepared"
}

install_image() {
    [[ -f $TARGET_IMAGE ]] || die "missing $TARGET_IMAGE"
    log "extracting the prebuilt X system image"
    tar --zstd -xpf "$TARGET_IMAGE" -C "$MNT" --xattrs --numeric-owner
    arch-chroot "$MNT" test -x /usr/bin/x || die 'the image does not contain the x CLI'
    [[ -f $MNT/etc/skel/.config/hypr/hyprland.lua ]] \
        || die 'the image does not contain the Hyprland payload'
    [[ -f $MNT/boot/vmlinuz-linux-x ]] || die 'the image does not contain the kernel'
    ok "system image extracted"
}

system_config() {
    phase "configuring the system"
    arch-chroot "$MNT" ldconfig
    arch-chroot "$MNT" systemd-machine-id-setup
    arch-chroot "$MNT" systemctl mask systemd-firstboot.service >/dev/null 2>&1 || true
    arch-chroot "$MNT" systemd-sysusers
    arch-chroot "$MNT" systemd-tmpfiles --create
    if arch-chroot "$MNT" test -x /usr/bin/update-ca-trust; then
        arch-chroot "$MNT" update-ca-trust
    fi
    if arch-chroot "$MNT" test -x /usr/bin/x-release-apply; then
        arch-chroot "$MNT" /usr/bin/x-release-apply || true
    fi

    genfstab -U "$MNT" >> "$MNT/etc/fstab"
    printf 'tmpfs /tmp tmpfs defaults,noatime,mode=1777 0 0\n' >> "$MNT/etc/fstab"

    arch-chroot "$MNT" ln -sf "/usr/share/zoneinfo/$TIMEZONE" /etc/localtime
    local pattern="${LOCALE//./\\.}"
    arch-chroot "$MNT" bash -c \
        "sed -i 's/^#[[:space:]]*${pattern}[[:space:]]/${LOCALE} /' /etc/locale.gen"
    if ! arch-chroot "$MNT" grep -q "^${LOCALE} " /etc/locale.gen; then
        printf '%s UTF-8\n' "$LOCALE" >> "$MNT/etc/locale.gen"
    fi
    arch-chroot "$MNT" locale-gen >/dev/null
    printf 'LANG=%s\n' "$LOCALE" > "$MNT/etc/locale.conf"
    printf 'KEYMAP=%s\n' "$KEYMAP" > "$MNT/etc/vconsole.conf"
    if ! grep -q '^XKB_DEFAULT_LAYOUT=' "$MNT/etc/environment" 2>/dev/null; then
        printf 'XKB_DEFAULT_LAYOUT=%s\n' "$KEYMAP" >> "$MNT/etc/environment"
    fi
    printf '%s\n' "$HOST" > "$MNT/etc/hostname"
    if ! grep -qE "^127\.0\.1\.1[[:space:]]+$HOST\$" "$MNT/etc/hosts"; then
        printf '127.0.1.1 %s\n' "$HOST" >> "$MNT/etc/hosts"
    fi

    local sh
    for sh in /bin/zsh /usr/bin/zsh; do
        grep -qx "$sh" "$MNT/etc/shells" 2>/dev/null \
            || printf '%s\n' "$sh" >> "$MNT/etc/shells"
    done
    if ! arch-chroot "$MNT" id -u "$USER" >/dev/null 2>&1; then
        arch-chroot "$MNT" useradd -m -G wheel -s /usr/bin/zsh "$USER"
    fi
    if [[ ! -d $MNT/home/$USER/.config/hypr ]]; then
        warn "useradd did not seed the desktop payload; copying /etc/skel"
        arch-chroot "$MNT" cp -a /etc/skel/. "/home/$USER/"
    fi
    printf '%s:%s\n' "$USER" "$PASS" | arch-chroot "$MNT" chpasswd
    printf '%%wheel ALL=(ALL:ALL) ALL\n' > "$MNT/etc/sudoers.d/10-wheel"
    chmod 440 "$MNT/etc/sudoers.d/10-wheel"
    arch-chroot "$MNT" usermod -aG video,render,input "$USER" 2>/dev/null || true

    # The prebuilt desktop was staged with a placeholder for the build home.
    local refs
    refs="$(grep -rIl -- '__XFULL_HOME__' "$MNT/home/$USER" 2>/dev/null || true)"
    if [[ -n $refs ]]; then
        printf '%s\n' "$refs" | while IFS= read -r f; do
            sed -i "s|__XFULL_HOME__|/home/$USER|g" "$f"
        done
    fi
    arch-chroot "$MNT" chown -R "$USER:$USER" "/home/$USER"

    [[ -d $MNT/home/$USER/.config/hypr ]] \
        || die "the desktop payload was not copied into /home/$USER"
    if [[ -f $MNT/home/$USER/.config/hypr/settings.json ]]; then
        arch-chroot "$MNT" jq --arg w "/home/$USER/.config/hypr/wallpapers" \
            ".wallpaperDir = \$w" "/home/$USER/.config/hypr/settings.json" > /tmp/xfull-settings.json
        install -m 0644 /tmp/xfull-settings.json "$MNT/home/$USER/.config/hypr/settings.json"
        arch-chroot "$MNT" chown "$USER:$USER" "/home/$USER/.config/hypr/settings.json"
        rm -f /tmp/xfull-settings.json
    fi

    arch-chroot "$MNT" systemctl enable NetworkManager.service >/dev/null 2>&1 || true
    arch-chroot "$MNT" systemctl enable sddm.service >/dev/null 2>&1 || true
    arch-chroot "$MNT" systemctl enable power-profiles-daemon.service >/dev/null 2>&1 || true
    arch-chroot "$MNT" systemctl enable bluetooth.service >/dev/null 2>&1 || true
    arch-chroot "$MNT" systemctl enable fstrim.timer >/dev/null 2>&1 || true
    arch-chroot "$MNT" systemctl --global enable pipewire pipewire-pulse wireplumber >/dev/null 2>&1 || true
    ok "system configured"
}

ensure_keyrings() {
    phase "checking the target keyrings"
    local gpgdir fpr
    if [[ -d $MNT/etc/pacman.d/gnupg && -d $MNT/etc/xpm/gnupg ]]; then
        ok "keyrings are prebuilt"
        return 0
    fi
    warn "keyrings missing from the image; initializing them now"
    # arch-chroot mounts a tmpfs on /tmp: use a persistent path inside /mnt.
    install -Dm644 "$ASSETS/x-repo.pub" "$MNT/etc/x-full-repo.pub"
    for gpgdir in /etc/pacman.d/gnupg /etc/xpm/gnupg; do
        arch-chroot "$MNT" pacman-key --gpgdir "$gpgdir" --init
        arch-chroot "$MNT" pacman-key --gpgdir "$gpgdir" --populate archlinux
        arch-chroot "$MNT" pacman-key --gpgdir "$gpgdir" --add /etc/x-full-repo.pub
        fpr="$(arch-chroot "$MNT" gpg --batch --homedir "$gpgdir" --with-colons \
            --show-keys /etc/x-full-repo.pub 2>/dev/null | awk -F: '/^fpr:/{print $10; exit}')"
        [[ -n $fpr ]] || die "could not read the [x] repository key"
        arch-chroot "$MNT" pacman-key --gpgdir "$gpgdir" --lsign-key "$fpr"
    done
    rm -f "$MNT/etc/x-full-repo.pub"
}

boot_files() {
    if [[ $ENC == yes ]]; then
        phase "rebuilding the initramfs for LUKS + $KEYMAP keymap"
        arch-chroot "$MNT" sed -i \
            's/^HOOKS=.*/HOOKS=(base udev microcode modconf kms keyboard keymap consolefont block encrypt filesystems)/' \
            /etc/mkinitcpio.conf
        arch-chroot "$MNT" mkinitcpio -P
    fi
    local f
    for f in /boot/vmlinuz-linux-x /boot/initramfs-linux-x.img; do
        arch-chroot "$MNT" test -f "$f" || die "missing $f after extraction"
    done
}

kernel_cmdline() {
    local root_uuid
    if [[ $ENC == yes ]]; then
        root_uuid="$LUKS_UUID"
        CMDLINE="cryptdevice=UUID=$root_uuid:xroot root=/dev/mapper/xroot rw rootflags=subvol=@"
    else
        root_uuid="$(blkid -s UUID -o value "$ROOTP")"
        CMDLINE="root=UUID=$root_uuid rw rootflags=subvol=@"
    fi
    if command -v lspci >/dev/null 2>&1 && lspci 2>/dev/null | grep -qiE 'vga.*nvidia|3d.*nvidia'; then
        CMDLINE="$CMDLINE nvidia-drm.modeset=1 nvidia-drm.fbdev=1"
    fi
    [[ -n ${EXTRA_PARAMS:-} ]] && CMDLINE="$CMDLINE $EXTRA_PARAMS"
    log "kernel cmdline: $CMDLINE"
}

install_bootloader() {
    phase "installing the bootloader ($BOOT)"
    local saved_fallback=""
    case "$BOOT" in
        grub)
            if [[ -d /sys/firmware/efi ]]; then
                arch-chroot "$MNT" grub-install --target=x86_64-efi \
                    --efi-directory=/boot --bootloader-id=x-full --recheck
                mkdir -p "$MNT/boot/EFI/BOOT"
                if [[ -f $MNT/boot/EFI/x-full/grubx64.efi ]]; then
                    cp "$MNT/boot/EFI/x-full/grubx64.efi" "$MNT/boot/EFI/BOOT/BOOTX64.EFI"
                fi
            else
                arch-chroot "$MNT" grub-install --target=i386-pc --recheck "$DISK"
            fi
            printf 'GRUB_DISTRIBUTOR="X"\nGRUB_TIMEOUT=3\nGRUB_DISABLE_OS_PROBER=true\nGRUB_DISABLE_RECOVERY=true\nGRUB_CMDLINE_LINUX="%s"\n' \
                "$CMDLINE" > "$MNT/etc/default/grub"
            arch-chroot "$MNT" grub-mkconfig -o /boot/grub/grub.cfg >/dev/null
            ;;
        systemd-boot)
            if [[ $MODE == dualboot && -f $MNT/boot/EFI/BOOT/BOOTX64.EFI ]]; then
                saved_fallback="$(mktemp)"
                cp -a "$MNT/boot/EFI/BOOT/BOOTX64.EFI" "$saved_fallback"
            fi
            arch-chroot "$MNT" bootctl --esp-path=/boot install >/dev/null
            if [[ -n $saved_fallback ]]; then
                cp -a "$saved_fallback" "$MNT/boot/EFI/BOOT/BOOTX64.EFI"
                rm -f "$saved_fallback"
            fi
            install -d "$MNT/boot/loader/entries"
            printf 'default x-full.conf\ntimeout 3\n' > "$MNT/boot/loader/loader.conf"
            cat > "$MNT/boot/loader/entries/x-full.conf" <<EOF
title X Linux
linux /vmlinuz-linux-x
initrd /initramfs-linux-x.img
options $CMDLINE
EOF
            ;;
    esac
    ok "bootloader installed"
}

first_generation() {
    phase "recording the first system generation"
    if arch-chroot "$MNT" env X_PKG_BACKEND=xpm X_GEN_CMDLINE="$CMDLINE" \
        X_GEN_LIVE_SUBVOL=/@ X_GEN_SUBVOL_PREFIX=/@snapshots \
        x gen new --reason install --label first; then
        if arch-chroot "$MNT" test -e /var/lib/x/current; then
            ok "generation 0001 recorded"
            printf 'XFULL_GEN=ok\n' | tee -a "$LOG" >&2
        else
            warn "x gen new finished but /var/lib/x/current is missing"
            printf 'XFULL_GEN=missing\n' | tee -a "$LOG" >&2
        fi
    else
        warn "the first generation was not recorded"
        printf 'XFULL_GEN=failed\n' | tee -a "$LOG" >&2
    fi
}

do_install() {
    if ! mkdir /run/xfull-install.lock.d 2>/dev/null; then
        die "another installation is already running"
    fi
    exec 9>/run/xfull-install.lock
    flock -n 9 || die "another installation is already running"

    phase "partitioning"
    partition_disk
    phase "extracting the system"
    install_image
    ensure_keyrings
    system_config
    boot_files
    kernel_cmdline
    install_bootloader
    first_generation

    phase "syncing"
    sync
    umount -R "$MNT"
    if [[ $ENC == yes ]]; then cryptsetup close xroot 2>/dev/null || true; fi
    rmdir /run/xfull-install.lock.d 2>/dev/null || true
    trap - EXIT

    ok "installation complete"
    printf 'XFULL_DONE seconds=%s\n' "$SECONDS" | tee -a "$LOG" >&2
    log "log saved at $LOG"
    if [[ ${POWEROFF:-0} == 1 || ${XFULL_POWEROFF:-0} == 1 ]]; then
        poweroff -f
    elif [[ ${XFULL_AUTO:-0} != 1 ]] && gum confirm 'Reboot now?'; then
        reboot -f
    fi
}

main() {
    [[ $EUID -eq 0 ]] || die 'run as root'
    [[ -f $TARGET_IMAGE ]] || die "missing $TARGET_IMAGE"
    [[ -d $ASSETS ]] || die "missing $ASSETS"
    : > "$LOG"
    parse_cmdline
    if [[ ${XFULL_AUTO:-0} == 1 ]]; then
        log "non-interactive mode: disk=${XFULL_DISK:-} locale=${XFULL_LOCALE:-} keymap=${XFULL_KEYMAP:-}"
        auto_options
    else
        command -v gum >/dev/null 2>&1 || die 'gum is not available'
        banner
        ask_options
        gum confirm 'Install X Full now?' || exit 1
    fi
    do_install
}

main "$@"
